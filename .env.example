# ejemplo de archivo .env para configurar la base de datos
# para sqlite, configura DB_ENGINE y DB_NAME como se muestra a continuación:

DB_ENGINE=sqlite
DB_NAME=ecotech_practica.db

# Para MySQL, cambia DB_ENGINE y DB_NAME y configura las credenciales:

DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecotech_practica
DB_USER=root
DB_PASSWORD=
