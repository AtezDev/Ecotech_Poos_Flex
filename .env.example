DB_ENGINE=sqlite
DB_NAME=ecotech_practica.db

# Clave de la cuenta admin que crea la opción 3 de semillas (mínimo 15 caracteres).
# Copia la línea a tu .env local y pon tu propia clave. No subas tu .env a GitHub.
# ADMIN_PASSWORD=

# Para MySQL, cambia DB_ENGINE y DB_NAME y configura las credenciales:
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ecotech_practica
# DB_USER=root
# DB_PASSWORD=
